{
  "name": "zipFlow",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run serve:ssr",
    "start:dev": "ng serve --proxy-config proxy.conf.json",
    "build": "rmdir dist /S && ng build",
    "build:prod": "npm run build:ssr:prod",
    "dev:ssr": "ng run zipFlow:serve-ssr",
    "serve:ssr": "node dist/zipFlow/server/server.mjs",
    "build:ssr:prod": "ng build && ng run zipFlow:build:production",
    "build:ssr": "ng build --prod && ng run zipFlow:build:production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/cdk": "^17.0.3",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
